{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "allowJs": true, "types": ["node"],
    "lib": ["ES2023", "DOM"], "skipLibCheck": true
  },
  "include": ["*.ts", "support/**/*.ts", "specs/**/*.ts", "harness/*.mjs"]
}
