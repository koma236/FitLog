  "requirements": [
    {
      "id": "REQ-01",
      "source": "requirements",
      "text": "登録・ログイン・ログアウトとサーバー側の認証・失効を実装する。"
    },
    {
      "id": "REQ-02",
      "source": "requirements",
      "text": "全体と自分＋フォロー先の記録を、安定した新着順とカーソルで表示する。"
    },
    {
      "id": "REQ-03",
      "source": "requirements",
      "text": "実施日・種目・セット・メモを記録し、本人だけが編集・削除できる。"
    },
    {
      "id": "REQ-04",
      "source": "requirements",
      "text": "投稿・プロフィール画像を検証してS3に保存し、権限と失敗時の整合性を守る。"
    },
    {
      "id": "REQ-05",
      "source": "requirements",
      "text": "コメントの作成・一覧・本人による編集・削除と件数を提供する。"
    },
    {
      "id": "REQ-06",
      "source": "requirements",
      "text": "1ユーザー1投稿1いいねを保証し、冪等な付与と解除を提供する。"
    },
    {
      "id": "REQ-07",
      "source": "requirements",
      "text": "自己フォローを禁止し、フォロー・解除・ユーザー検索を提供する。"
    },
    {
      "id": "REQ-08",
      "source": "requirements",
      "text": "プロフィールと記録一覧を表示し、本人だけがプロフィールを編集できる。"
    },
    {
      "id": "REQ-09",
      "source": "requirements",
      "text": "承認した技術構成のローカル環境、DB制約、OpenAPI、実行可能な品質checksを用意する。"
    },
    {
      "id": "REQ-10",
      "source": "requirements",
      "text": "低費用のデモ環境をIaCで構築・デプロイ・検証・破棄・再構築できる。"
    },
    {
      "id": "REQ-11",
      "source": "requirements",
      "text": "秘密情報を漏らさないログ、ヘルスチェック、監視・障害対応手順を整備する。"
    },
    {
      "id": "REQ-12",
      "source": "requirements",
      "text": "受け入れ条件に基づくE2E・性能検証と、AWSでの動作撮影シナリオを用意する。"
    }
  ],
  "acceptance": [
    {
      "id": "AC-01",
      "source": "acceptance",
      "requirements": [
        "REQ-01"
      ],
      "text": "Aの登録・ログイン後にmeがAを返し、ログアウト後は旧Cookieで拒否される。重複登録はユーザーを増やさず、CSRFのないログイン・更新は拒否される。"
    },
    {
      "id": "AC-02",
      "source": "acceptance",
      "requirements": [
        "REQ-02"
      ],
      "text": "AがBのみをフォローしCも存在する固定データで、フォロー中はA/Bだけ、全体はA/B/Cを新着順で返す。同時刻の境界を跨いで重複・欠落なく終端に到達する。"
    },
    {
      "id": "AC-03",
      "source": "acceptance",
      "requirements": [
        "REQ-03"
      ],
      "text": "60kg×10回の3セットを保存し、再取得・再起動後も全値が一致する。回数0・重量負数・不正日付・種目なしは拒否し一部保存しない。BによるAの編集削除を拒否し、Aの削除で配下の関連を除去する。"
    },
    {
      "id": "AC-04",
      "source": "acceptance",
      "requirements": [
        "REQ-04"
      ],
      "text": "許可した実画像を保存・表示できる。拡張子だけ画像のファイル・容量超過・画素数超過を拒否する。S3保存失敗時は旧画像を維持し、DBとS3の削除失敗は追跡して再試行できる。"
    },
    {
      "id": "AC-05",
      "source": "acceptance",
      "requirements": [
        "REQ-05"
      ],
      "text": "BのコメントがAの記録に表示され、編集後も件数は同じ、削除後は1減る。AによるBのコメント編集削除を拒否し、空白のみ・上限超過・削除済み投稿への送信を拒否する。"
    },
    {
      "id": "AC-06",
      "source": "acceptance",
      "requirements": [
        "REQ-06"
      ],
      "text": "同じ利用者から並行して2回いいねしてもDBは1行・件数は1増加。解除の再送でも0を下回らず、リロード後の状態が一致する。"
    },
    {
      "id": "AC-07",
      "source": "acceptance",
      "requirements": [
        "REQ-07"
      ],
      "text": "A→Bを重複なく付与・解除でき、自己フォローを拒否する。検索は指定文字列の部分一致で、%/_を入力しても無条件一致にならない。フォロー中一覧と数が連動する。"
    },
    {
      "id": "AC-08",
      "source": "acceptance",
      "requirements": [
        "REQ-08"
      ],
      "text": "Aの表示名・自己紹介が更新され、Bのプロフィール応答にAのメールが含まれない。Bの認証でAを更新できず、プロフィールの記録一覧はAの記録だけになる。"
    },
    {
      "id": "AC-09",
      "source": "acceptance",
      "requirements": [
        "REQ-09"
      ],
      "text": "承認した依存lockからローカル環境を起動し、migrationを空DBに適用できる。実在するlint・型・単体・DB結合checkを実行して終了コードと対象を記録し、そのコマンドをv9設定に登録する。"
    },
    {
      "id": "AC-10",
      "source": "acceptance",
      "requirements": [
        "REQ-10"
      ],
      "text": "独自ドメインを取得せず専用環境をapply・配置・migration・seedし、CloudFront提供URLでHTTPS接続してAWS上の認証・画像・交流を操作する。再構築後は新しいoutput URLで同じ操作が成立する。動画をAWS外に保存した後destroyし、stateと対象リソースの残存検査を行う。再applyから同じシナリオを再現して再destroyし、費用見積りと実行時間を記録する。"
    },
    {
      "id": "AC-11",
      "source": "acceptance",
      "requirements": [
        "REQ-11"
      ],
      "text": "DB断でreadinessが異常、復旧で正常に戻る。処理失敗をrequest_idで追跡でき、パスワード・Cookie・メール・本文・署名URLがログにない。S3失敗とdestroy失敗の手順を確認する。"
    },
    {
      "id": "AC-12",
      "source": "acceptance",
      "requirements": [
        "REQ-12"
      ],
      "text": "2ユーザーの主要E2Eと固定負荷性能検証を実行し、対象commit・環境・結果を記録する。AWS動作動画は実際の操作を含み、モック映像と区別され、破棄後もローカルで再生できる。"
    }
  ],
  "questions": [
    {
      "id": "Q-01",
      "text": "筋トレだけか、有酸素の距離・時間も初版に含めるか。",
      "blocking": true,
      "resolution": "ユーザー回答により筋トレ中心と確定。有酸素の距離・時間は初版に含めない。"
    },
    {
      "id": "Q-02",
      "text": "React継続、Python/Django/DRF/ORM/セッションの採用案を確定する。",
      "blocking": true,
      "resolution": null
    },
    {
      "id": "Q-03",
      "text": "記録の公開範囲を確定する。",
      "blocking": true,
      "resolution": "ユーザーが全記録をログイン利用者全員に公開する案に同意。ゲスト非公開、本人だけが編集削除できる。"
    },
    {
      "id": "Q-04",
      "text": "公開ドメインとブラウザ側HTTPS方式を確定する。",
      "blocking": true,
      "resolution": "ユーザー回答により独自ドメインなし。MyTimelineと同じCloudFront提供ドメインと既定証明書を使う。AWS内部構成はQ-08で扱う。"
    },
    {
      "id": "Q-05",
      "text": "依存版・ポート・実checksと初回基盤構築のv9手順を確定する。",
      "blocking": true,
      "resolution": null
    },
    {
      "id": "Q-06",
      "text": "仕様詳細化後、既存ルーティングのClaudeによる独立設計レビューを実施する。",
      "blocking": true,
      "resolution": null
    },
    {
      "id": "Q-07",
      "text": "OpenAPI詳細契約とMyTimeline相当の全操作UIモックを完成する。",
      "blocking": true,
      "resolution": "OpenAPIの入出力・エラー・認証契約と8画面の疑似操作モックを作成。ブラウザで主要操作を確認。製品APIの動作・独立レビューとは区別する。"
    },
    {
      "id": "Q-08",
      "text": "NATなしFargate・public ALBの推奨案と主要料金の試算を作成。内部HTTP経路・総費用を独立レビューし採用を確定する。",
      "blocking": true,
      "resolution": null
    }
  ]
}
