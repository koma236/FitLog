  "requirements": [
    {
      "id": "FL01-REQ",
      "source": "fl01-requirements",
      "text": "FL-01設計の範囲でDocker ComposeによるReact/TypeScript・Django/DRF・PostgreSQLのローカル基盤と実品質checkを構築する。後続の機能とAWS操作は実装しない。"
    }
  ],
  "acceptance": [
    {
      "id": "FL01-AC1",
      "source": "fl01-acceptance",
      "requirements": [
        "FL01-REQ"
      ],
      "text": "UUID主キーの保存・再取得、PostgreSQL隔離テストDBへの初回と再migration、開発DBへのmigrate、migration driftなしを検証する。"
    },
    {
      "id": "FL01-AC2",
      "source": "fl01-acceptance",
      "requirements": [
        "FL01-REQ"
      ],
      "text": "DB/migration状態、request-id、DEBUG両モードのJSONエラーと例外分類表、healthPOSTの405を契約と照合し、秘密を露出しない。"
    },
    {
      "id": "FL01-AC3",
      "source": "fl01-acceptance",
      "requirements": [
        "FL01-REQ"
      ],
      "text": "readyの各状態・5秒timeout・unmountをroleと固定文言でDOM検証する。"
    },
    {
      "id": "FL01-AC4",
      "source": "fl01-acceptance",
      "requirements": [
        "FL01-REQ"
      ],
      "text": "予定した静的解析・型・DBテスト・frontendテスト・buildを実行し、常時成功・全体ignore・テスト0件で代用しない。"
    },
    {
      "id": "FL01-AC5",
      "source": "fl01-acceptance",
      "requirements": [
        "FL01-REQ"
      ],
      "text": "lockを使った再build・起動停止とcheckの手順を残し、hostの既存環境・他プロジェクトを変更しない。"
    }
  ],
  "questions": []
}
