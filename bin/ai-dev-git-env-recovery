#!/bin/bash -p
# Inspect observable exported names before creating the closed child environment.
for recovery_name in $(builtin compgen -e); do
  case "$recovery_name" in
    GIT_CONFIG_PARAMETERS|GIT_CONFIG_COUNT|GIT_CONFIG|GIT_CONFIG_GLOBAL|GIT_CONFIG_SYSTEM|GIT_DIR|GIT_WORK_TREE|GIT_INDEX_FILE|GIT_COMMON_DIR|GIT_OBJECT_DIRECTORY|GIT_ALTERNATE_OBJECT_DIRECTORIES|GIT_SSH|GIT_SSH_COMMAND|GIT_ASKPASS|SSH_ASKPASS|GIT_EXEC_PATH|GIT_GRAFT_FILE|GH_TOKEN|GITHUB_TOKEN|GH_HOST|GH_CONFIG_DIR|BASH_ENV|ENV|SHELLOPTS|GIT_CONFIG_KEY_*|GIT_CONFIG_VALUE_*|BASH_FUNC_*|DYLD_*|LD_*|PYTHON*|VSCODE_GIT_ASKPASS_*)
      builtin printf '%s\n' 'V9_ENV_RECOVERY: environment_override_refused' >&2
      exit 2
      ;;
  esac
done
if [[ "$HOME" != /Users/saki || "$CODEX_HOME" != /Users/saki/.codex-personal ]]; then
  builtin printf '%s\n' 'V9_ENV_RECOVERY: personal_home_refused' >&2
  exit 2
fi
case "${1-}" in
  prepare|execute|status|prepare-pr|--help|-h) ;;
  *)
    builtin printf '%s\n' 'V9_ENV_RECOVERY: public_action_refused' >&2
    exit 2
    ;;
esac
builtin cd -- "${BASH_SOURCE[0]%/*}/.." || exit 2
builtin exec /usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin HOME=/Users/saki CODEX_HOME=/Users/saki/.codex-personal TMPDIR=/private/tmp LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 /Library/Frameworks/Python.framework/Versions/3.12/bin/python3.12 -I -S -B "$PWD/scripts/v9_git_environment_recovery.py" "$@"
