# Local-only examples; no production credentials. Compose passes these samples directly.
# DJANGO_SECRET_KEY is mandatory when Django is started outside Compose.
DJANGO_SECRET_KEY=fitlog-local-only-public-key-never-use-in-production
DJANGO_DEBUG=false
FITLOG_ENV=local
FITLOG_LOCAL_HTTP=1
# Public local sample, explicitly rejected in production.
AUTH_RATE_LIMIT_HMAC_KEY=fitlog-local-only-public-hmac-key-never-use-in-production
POSTGRES_DB=fitlog
POSTGRES_USER=fitlog
POSTGRES_PASSWORD=fitlog-local-only-not-a-secret
POSTGRES_HOST=postgres

# Exact image tags and registry digests are pinned in compose.yaml and Dockerfiles.
# Their recorded references are in backend/image-pins.json; no image environment
# variables are needed. Dependencies are recorded in backend/uv.lock and
# frontend/package-lock.json. Check results belong to the quality-check report and the PR.


# Production uses backend/Dockerfile.production and config.production.
# Do not reuse the local examples above. Supply distinct private secrets externally.
# Required production settings (see docs/production-readiness.md):
# DJANGO_SECRET_KEY=<private, 50+ characters>
# AUTH_RATE_LIMIT_HMAC_KEY=<different private value, 32+ characters>
# FITLOG_PUBLIC_HOST=<single distribution DNS name>.cloudfront.net
# PRIVATE_MEDIA_BUCKET=<general-purpose private bucket>
# PRIVATE_MEDIA_EXPECTED_OWNER=<12-digit account ID>
# AWS_REGION=ap-northeast-1
# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_HOST=<required>
# POSTGRES_SSLROOTCERT=<readable, valid CA bundle path mounted in container>
# FITLOG_TRUST_PROXY=0  # default; enable only after the FL-09B ingress checks
# No static AWS access keys: deployed workloads must use an IAM role.
